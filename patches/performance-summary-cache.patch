+
+import { POST } from './route';
+
+const parameters = {
+  startDate: new Date('2026-08-01T00:00:00.000Z'),
+  endDate: new Date('2026-08-08T00:00:00.000Z'),
+  unit: 'day',
+  timezone: 'UTC',
+  metric: 'lcp',
+};
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.parseRequest.mockResolvedValue({
+    auth: { user: { id: 'user-1' } },
+    body: { websiteId: 'website-1', filters: {}, type: 'performance', parameters },
+    error: undefined,
+  });
+  mocks.setWebsiteDate.mockImplementation((_websiteId, data) => data);
+  mocks.getQueryFilters.mockResolvedValue({});
+  mocks.canViewWebsiteSection.mockResolvedValue(true);
+  mocks.getPerformanceMetrics.mockResolvedValue([]);
+});
+
+describe('performance report sections', () => {
+  test('summary returns only the all-metric summary', async () => {
+    const summary = { count: 3 };
+    mocks.parseRequest.mockResolvedValue({
+      auth: { user: { id: 'user-1' } },
+      body: { websiteId: 'website-1', filters: {}, type: 'performance', parameters: { ...parameters, section: 'summary' } },
+      error: undefined,
+    });
+    mocks.getPerformance.mockResolvedValue({ summary });
+
+    const response = await POST(new Request('http://localhost/api/reports/performance', { method: 'POST' }));
+
+    await expect(response.json()).resolves.toEqual({ summary });
+    expect(mocks.getPerformanceMetrics).not.toHaveBeenCalled();
+  });
+
+  test('details returns the legacy detail fields without summary', async () => {
+    mocks.parseRequest.mockResolvedValue({
+      auth: { user: { id: 'user-1' } },
+      body: { websiteId: 'website-1', filters: {}, type: 'performance', parameters: { ...parameters, section: 'details' } },
+      error: undefined,
+    });
+    mocks.getPerformance.mockResolvedValue({ chart: [] });
+
+    const response = await POST(new Request('http://localhost/api/reports/performance', { method: 'POST' }));
+
+    await expect(response.json()).resolves.toEqual({
+      chart: [], pages: [], pageTitles: [], devices: [], browsers: [],
+    });
+  });
+});
diff --git a/src/components/hooks/queries/usePerformanceQuery.ts b/src/components/hooks/queries/usePerformanceQuery.ts
new file mode 100644
index 0000000..8990928
--- /dev/null
+++ b/src/components/hooks/queries/usePerformanceQuery.ts
@@ -0,0 +1,95 @@
+import { useQueryClient } from '@tanstack/react-query';
+import { useEffect, useMemo } from 'react';
+import type { ReactQueryOptions } from '@/lib/types';
+import { useApi } from '../useApi';
+import { useDateParameters } from '../useDateParameters';
+import { useFilterParameters } from '../useFilterParameters';
+
+export interface PerformanceQueryScope {
+  websiteId: string;
+  startDate: string;
+  endDate: string;
+  timezone: string;
+  unit: string;
+  filters: Record<string, any>;
+}
+
+type PerformanceQueryPost = (url: string, body: Record<string, any>) => Promise<any>;
+
+function queryKey(scope: PerformanceQueryScope, section: 'summary' | 'details', metric?: string) {
+  const { filters, ...parameters } = scope;
+  return ['reports', { type: 'performance', section, ...parameters, ...filters, ...(metric && { metric }) }];
+}
+
+function request(scope: PerformanceQueryScope, section: 'summary' | 'details', metric?: string) {
+  const { filters, ...parameters } = scope;
+  return {
+    websiteId: scope.websiteId,
+    type: 'performance',
+    filters,
+    parameters: { ...parameters, ...(metric && { metric }), section },
+  };
+}
+
+export function createPerformanceSummaryQueryOptions(scope: PerformanceQueryScope, post: PerformanceQueryPost) {
+  return {
+    queryKey: queryKey(scope, 'summary'),
+    queryFn: () => post('/reports/performance', request(scope, 'summary')),
+  };
+}
+
+export function createPerformanceDetailsQueryOptions(
+  scope: PerformanceQueryScope,
+  metric: string,
+  post: PerformanceQueryPost,
+) {
+  return {
+    queryKey: queryKey(scope, 'details', metric),
+    queryFn: () => post('/reports/performance', request(scope, 'details', metric)),
+  };
+}
+
+export function usePerformanceQuery(
+  {
+    websiteId,
+    startDate,
+    endDate,
+    metric,
+  }: { websiteId: string; startDate: Date; endDate: Date; metric: string },
+  options?: ReactQueryOptions,
+) {
+  const { post, useQuery } = useApi();
+  const queryClient = useQueryClient();
+  const { timezone, unit } = useDateParameters();
+  const filters = useFilterParameters({ includePagination: false });
+  const scope = useMemo(
+    () => ({ websiteId, startDate: startDate.toISOString(), endDate: endDate.toISOString(), timezone, unit, filters }),
+    [websiteId, startDate, endDate, timezone, unit, filters],
+  );
+  const summaryOptions = useMemo(
+    () => createPerformanceSummaryQueryOptions(scope, post),
+    [scope, post],
+  );
+  const detailsOptions = useMemo(
+    () => createPerformanceDetailsQueryOptions(scope, metric, post),
+    [scope, metric, post],
+  );
+  const summaryQuery = useQuery({ ...summaryOptions, enabled: !!websiteId });
+  const detailsQuery = useQuery({ ...detailsOptions, enabled: !!websiteId, ...options });
+
+  useEffect(() => {
+    if (!websiteId) return;
+    void queryClient.fetchQuery(summaryOptions).catch(() => undefined);
+  }, [metric, summaryOptions, queryClient, websiteId]);
+
+  return {
+    ...detailsQuery,
+    data: detailsQuery.data && summaryQuery.data
+      ? { ...detailsQuery.data, summary: summaryQuery.data.summary }
+      : undefined,
+    error: detailsQuery.error || summaryQuery.error,
+    isLoading: detailsQuery.isLoading || summaryQuery.isLoading,
+    isPending: detailsQuery.isPending || summaryQuery.isPending,
+    isFetching: detailsQuery.isFetching || summaryQuery.isFetching,
+  };
+}
