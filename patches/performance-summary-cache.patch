+  canViewWebsiteSection: vi.fn(),
+  getPerformance: vi.fn(),
+  getPerformanceMetrics: vi.fn(),
+}));
+
+vi.mock('@/lib/request', () => ({
+  parseRequest: mocks.parseRequest,
+  setWebsiteDate: mocks.setWebsiteDate,
+  getQueryFilters: mocks.getQueryFilters,
+}));
+
+vi.mock('@/permissions', () => ({ canViewWebsiteSection: mocks.canViewWebsiteSection }));
+vi.mock('@/queries/sql/reports/getPerformance', () => ({ getPerformance: mocks.getPerformance }));
+vi.mock('@/queries/sql/reports/getPerformanceMetrics', () => ({ getPerformanceMetrics: mocks.getPerformanceMetrics }));
+vi.mock('@/lib/response', () => ({
+  json: (body: unknown) => new Response(JSON.stringify(body), { status: 200 }),
+  unauthorized: () => new Response(null, { status: 401 }),
