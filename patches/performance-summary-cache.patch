@@ -0,0 +1,149 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { renderHook, waitFor } from '@testing-library/react';
+import { createElement } from 'react';
+import { beforeEach, describe, expect, test, vi } from 'vitest';
+
+const hookMocks = vi.hoisted(() => ({ post: vi.fn(), filters: { country: 'US' } }));
+
+vi.mock('../useApi', async () => {
+  const { useQuery } = await import('@tanstack/react-query');
+  return { useApi: () => ({ post: hookMocks.post, useQuery }) };
+});
+vi.mock('../useDateParameters', () => ({
+  useDateParameters: () => ({ startDate: 'helper-start', endDate: 'helper-end', timezone: 'UTC', unit: 'day' }),
+}));
+vi.mock('../useFilterParameters', () => ({
+  useFilterParameters: () => hookMocks.filters,
+}));
+
+import {
+  createPerformanceDetailsQueryOptions,
+  createPerformanceSummaryQueryOptions,
+  usePerformanceQuery,
+} from './usePerformanceQuery';
+
+const scope = {
+  websiteId: 'website-1',
+  startDate: '2026-08-01T00:00:00.000Z',
+  endDate: '2026-08-08T00:00:00.000Z',
+  timezone: 'UTC',
+  unit: 'day',
+  filters: { country: 'US', search: 'home' },
+};
+const details = { chart: [], pages: [], pageTitles: [], devices: [], browsers: [] };
+const summary = { summary: { count: 3 } };
+
+function setup() {
+  const post = vi.fn().mockImplementation((url: string, body: any) =>
+    Promise.resolve(body.parameters.section === 'summary' ? summary : details),
+  );
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false, staleTime: 60_000 } } });
+  return { post, queryClient };
+}
+
+function wrapper(queryClient: QueryClient) {
+  return ({ children }: { children: any }) => createElement(QueryClientProvider, { client: queryClient }, children);
+}
+
+describe('performance query cache partition', () => {
+  beforeEach(() => {
+    vi.useRealTimers();
+    hookMocks.post.mockReset();
+    hookMocks.filters = { country: 'US' };
+  });
+
+  test('uses caller dates instead of helper dates for the request scope', async () => {
+    const { post, queryClient } = setup();
+    hookMocks.post = post;
+    const startDate = new Date('2026-08-02T00:00:00.000Z');
+    const endDate = new Date('2026-08-09T00:00:00.000Z');
+    const { result } = renderHook(
+      () => usePerformanceQuery({ websiteId: 'website-1', startDate, endDate, metric: 'lcp' }),
+      { wrapper: wrapper(queryClient) },
+    );
+
+    await waitFor(() => expect(result.current.data).toEqual({ ...details, ...summary }));
+    const summaryRequest = post.mock.calls.find(([, body]) => body.parameters.section === 'summary');
+    expect(summaryRequest?.[1].parameters).toMatchObject({
+      startDate: startDate.toISOString(), endDate: endDate.toISOString(),
+    });
+  });
+
+  test('reuses one summary when switching metrics in the same scope', async () => {
+    const { post, queryClient } = setup();
+    hookMocks.post = post;
+    const dates = { startDate: new Date(scope.startDate), endDate: new Date(scope.endDate) };
+    const { result, rerender } = renderHook(
+      ({ metric }) => usePerformanceQuery({ websiteId: scope.websiteId, ...dates, metric }),
+      { initialProps: { metric: 'lcp' }, wrapper: wrapper(queryClient) },
+    );
+    await waitFor(() => expect(result.current.data).toEqual({ ...details, ...summary }));
+    rerender({ metric: 'inp' });
+    await waitFor(() => expect(result.current.data).toEqual({ ...details, ...summary }));
+
+    expect(post.mock.calls.filter(([, body]) => body.parameters.section === 'summary')).toHaveLength(1);
+  });
+
+  test('misses the summary cache when date or filters change', async () => {
+    const { post, queryClient } = setup();
+    hookMocks.post = post;
+    const startDate = new Date(scope.startDate);
+    const { rerender } = renderHook(
+      ({ endDate }) => usePerformanceQuery({ websiteId: scope.websiteId, startDate, endDate, metric: 'lcp' }),
